# La aplicación NO carga este archivo automáticamente: exporta las variables en el proceso.
# Variante local de SQLite; en producción usa una URL de base de datos gestionada.
QR_PASS_DATABASE_URL=sqlite:///./qrpass.db

# Orígenes permitidos por CORS, separados por comas. En desarrollo, si se omite, se permiten todos.
QR_PASS_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Clave para firmar los tokens de sesión (mínimo 32 bytes). Sin ella en desarrollo se genera una
# clave aleatoria al arrancar; en producción es obligatoria porque las sesiones deben sobrevivir
# al reinicio del proceso.
QR_PASS_AUTH_SECRET=cambia-esta-clave-por-una-de-al-menos-32-bytes-2026

# production exige QR_PASS_AUTH_SECRET y restringe CORS a los orígenes declarados arriba.
QR_PASS_ENV=development

# Sirve la carpeta ../frontend desde el mismo puerto que la API (lo usa iniciar.bat para el túnel HTTPS).
QR_PASS_SERVE_FRONTEND=1
